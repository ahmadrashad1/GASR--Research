# Raw workspace data dump -- 409MB, exceeds GitHub's 100MB single-file hard limit.
# Contains frames/masks/depth/checkpoints for one video; lives on Google Drive per
# the pipeline's own DRIVE_BASE convention, not meant to be git-tracked.
workspace_v3-20260810T112521Z-1-001.zip
workspace_v3/

# Python build artifacts
__pycache__/
*.pyc

# Claude Code local tool config (machine-specific permissions, not project content)
.claude/

# Generated dependency directories buried inside fyp-1 (installed packages, not source)
fyp-1/module-4-5-explanation-references/.venv/
fyp-1/module-4-5-explanation/node_modules/
fyp-1/report/node_modules/

# LibreOffice lock files (created while a .docx is open)
.~lock.*#

# LaTeX build artefacts and auto-generated tables (regenerate with make_tables.py)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
# ...except the compiled manuscript. It is the deliverable, and an examiner or
# reviewer should be able to read it from a clone without installing a LaTeX
# engine and re-running the build against result files they do not have.
!paper/research_paper.pdf
paper/generated_macros.tex
paper/generated_tables.tex

# tectonic binary downloaded by paper/build.sh
paper/tectonic
paper/tectonic.tar.gz

# Result archives downloaded from Drive for a local paper build
closeout_results.zip
closeout/

# Copied out of Drive to run the clinical demonstrator. frames/ holds real endoscopic
# stills, and putting surgical imagery into a public repository is not a decision to
# make by running `git add -A`. demo_data.js is large and regenerated by Module 9.
demo/clinical/frames/
demo/clinical/demo_data.js

# Clinical demonstrator build tree. The built page (demo/clinical/index.html) IS
# committed -- it is the deliverable and must work from a clone without npm.
demo/clinical-src/node_modules/
demo/clinical-src/dist/

# The local inference server's data. A patient video's tracked geometry, for the same
# reason demo/clinical/frames/ is ignored.
serve/live_bundle.npz
serve/__pycache__/

# The trained checkpoint: 261 MB, and GitHub refuses files over 100 MB anyway.
diffusion_ckpt_best.pth

# Doctor accounts: roll numbers and password hashes. A committed credential is a
# leaked credential, and a committed hash is one somebody can grind offline.
serve/doctors.json
serve/doctors.json.tmp

# Video rendered from the endoscopic stills. Same rule as demo/clinical/frames/:
# a video of a patient every bit as much as the frames it was made from.
demo/*.mp4
demo/predicted_future*.mp4

# Local mirror of the Drive result files, pulled with rclone. Read-only cache: the
# originals live on Drive and module9_demo/demo_data.json carries patient geometry.
.drive-cache/
